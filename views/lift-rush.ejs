<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LIFT RUSH - Tor-AI</title>
    <link rel="stylesheet" href="/css/lift-rush.css">
</head>
<body>
    <div id="game-container">
        <div class="hud">
            <div class="stats-panel">
                <div>SCORE: <span id="score">0</span></div>
                <div>BEST: <span id="best-score"><%= user.lift_rush_best_score %></span></div>
                <div class="energy-bar-container">
                    <div id="energy-fill" class="energy-bar-fill"></div>
                </div>
            </div>
            <div class="stats-panel">
                <div>SPEED: <span id="speed-val">1x</span></div>
                <div id="combo-text" style="color: var(--neon-pink); font-size: 14px; display: none;">COMBO x1</div>
            </div>
        </div>

        <canvas id="gameCanvas"></canvas>

        <div id="mobile-controls">
            <div class="control-btn" id="btn-left" onmousedown="setLeft(true)" onmouseup="setLeft(false)" ontouchstart="setLeft(true)" ontouchend="setLeft(false)">L</div>
            <div class="control-btn" id="btn-rise" onmousedown="setRise(true)" onmouseup="setRise(false)" ontouchstart="setRise(true)" ontouchend="setRise(false)">UP</div>
            <div class="control-btn" id="btn-right" onmousedown="setRight(true)" onmouseup="setRight(false)" ontouchstart="setRight(true)" ontouchend="setRight(false)">R</div>
        </div>

        <div id="start-screen" class="overlay">
            <h1>LIFT RUSH</h1>
            <p>홀드(Space/터치)하여 상승 | 장애물을 피하세요!</p>
            <button class="start-btn" onclick="startGame()">GO UP!</button>
            <div class="rank-info" id="start-rank-info">
                <div style="color: #888;">순위 정보를 불러오는 중...</div>
            </div>
            <p style="margin-top: 20px; font-size: 14px; color: #888;">PLAYER: <%= user.username %> | ATTEMPTS: <%= user.lift_rush_attempts %></p>
        </div>

        <div id="game-over-screen" class="overlay" style="display: none;">
            <h1 style="color: var(--neon-pink);">CRASHED!</h1>
            <p>FINAL SCORE: <span id="final-score">0</span></p>
            <div class="rank-info" id="end-rank-info">
                <div style="color: #888;">순위 정보를 확인하는 중...</div>
            </div>
            <button class="start-btn" onclick="startGame()">RETRY</button>
            <a href="/dashboard" class="back-link">EXIT TO DASHBOARD</a>
        </div>

        <div id="controls-hint">HOLD TO RISE | RELEASE TO STOP</div>
    </div>

    <script>
        const currentUser = {
            username: "<%= user.username %>",
            attempts: <%= user.lift_rush_attempts %>,
            bestScore: <%= user.lift_rush_best_score %>
        };
    </script>
    <script src="/js/lift-rush.js"></script>
</body>
</html>
