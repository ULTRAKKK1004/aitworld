<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Brick-Crasher - Tor-AI</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/game-layout.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
        }

        #active-effects {
            position: absolute;
            top: 100px;
            left: 0;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            pointer-events: none;
            z-index: 100;
        }
        .effect-text {
            background: rgba(0, 0, 0, 0.7);
            color: #0ff;
            padding: 5px 15px;
            border-radius: 20px;
            border: 1px solid #0ff;
            font-weight: bold;
            font-size: 14px;
            animation: fadeInOut 5s forwards;
            text-shadow: 0 0 10px #0ff;
        }
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(-10px); }
            10% { opacity: 1; transform: translateY(0); }
            90% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-10px); }
        }

        /* Force Portrait Warning on Mobile (Like Paper Rush style but reversed) */
        #rotate-warning {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100dvh;
            background: #000;
            color: #0ff; /* Neon Cyan */
            z-index: 10000;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        #rotate-warning i { font-size: 5rem; margin-bottom: 20px; animation: tilt-to-portrait 2s infinite; }
        @keyframes tilt-to-portrait { 0%, 100% { transform: rotate(90deg); } 50% { transform: rotate(0deg); } }

        /* 가로 모드일 때만 경고창 표시 */
        @media screen and (orientation: landscape) {
            #rotate-warning { display: flex !important; }
            .game-layout { display: none !important; }
        }
    </style>
</head>
<body>
    <!-- Paper Rush style rotate warning -->
    <div id="rotate-warning">
        <i class="fas fa-mobile-screen"></i>
        <p>세로 모드로 회전해주세요!</p>
        <p style="font-size: 14px; color: #888; margin-top: 10px;">이 게임은 세로 화면에 최적화되어 있습니다.</p>
    </div>

    <div class="game-layout">
        <aside class="sidebar left-sidebar">
            <div class="user-profile">
                <p>플레이어: <strong><%= user.username %></strong></p>
                <p>내 최고 점수: <span id="my-best-score"><%= user.brick_best_score || 0 %></span></p>
                <p>플레이 횟수: <span id="my-attempts"><%= user.brick_attempts %></span></p>
                <p>내 현재 순위: <span id="my-rank">-</span></p>
            </div>
            <div class="motivational-phrases" id="motivation">
            </div>
        </aside>

        <main class="game-area">
            <div id="game-container">
                <canvas id="gameCanvas" width="450" height="800"></canvas>
                <div id="ui-layer">
                    <div class="top-bar">
                        <div class="stat-box">
                            <span class="stat-label">TIME</span>
                            <span class="stat-value" id="timer">00:00</span>
                        </div>
                        <div class="stat-box">
                            <span class="stat-label">STAGE</span>
                            <span class="stat-value" id="stage">1</span>
                        </div>
                        <div class="stat-box">
                            <span class="stat-label">SCORE</span>
                            <span class="stat-value" id="score">0</span>
                        </div>
                    </div>
                    <div id="active-effects"></div>
                    <div class="bottom-bar">
                        <div class="stat-box">
                            <span class="stat-label">ATTACKS</span>
                            <div id="attacks-container"></div>
                        </div>
                    </div>
                </div>
                <div id="game-over-screen">
                    <h1 id="game-title">NEON BREAKOUT</h1>
                    <div id="stage-selection">
                        <p style="color:#fff; margin-bottom:15px; font-size:16px;">난이도를 선택하세요</p>
                        <div class="stage-select" id="stageGrid"></div>
                        <button class="main-btn" id="start-btn">게임 시작</button>
                    </div>
                    <div id="game-over-content" class="hidden" style="text-align:center;">
                        <h2 style="font-size: 32px; color: #f00; text-shadow: 0 0 20px #f00;">GAME OVER</h2>
                        <p style="font-size: 18px; margin: 10px 0;">Final Score: <span id="final-score" style="color:#fff">0</span></p>
                        <p style="font-size: 18px; margin: 10px 0;">Max Stage: <span id="final-stage" style="color:#0ff">1</span></p>
                        <button class="main-btn" id="restart-btn" style="margin-top:20px;">Retry</button>
                        <button class="main-btn" id="menu-btn" style="margin-top:10px; border-color:#0ff; color:#0ff; font-size: 16px; padding: 10px 30px;">Stage Select</button>
                        <button class="main-btn" onclick="exitToDashboard()" style="display:block; margin-top:10px; border-color:#fff; color:#fff; font-size: 14px; width:100%; cursor:pointer;">Back to Dashboard</button>
                    </div>
                    <div class="controls-hint">PC: 방향키 / 모바일: 화면 좌우 터치</div>
                    <div class="mobile-controls">
                        <div class="touch-btn" id="btn-left">←</div>
                        <div class="touch-btn" id="btn-right">→</div>
                    </div>
                </div>
            </div>
        </main>

        <aside class="sidebar right-sidebar">
            <h3>명예의 전당 (Top 10)</h3>
            <div class="leaderboard" id="top10">
            </div>
            
            <h3>내 경쟁자들</h3>
            <div class="leaderboard" id="rivals">
            </div>
        </aside>
    </div>

    <script src="/js/game-logic.js"></script>
    <script src="/js/scoreboard.js"></script>
    <script>
        const USER_BRICK_PADDLE_MULTIPLIER = <%= user.brick_paddle_multiplier || 1.0 %>;
        const USER_BRICK_SCORE_MULTIPLIER = <%= user.brick_score_multiplier || 1.0 %>;
        const USER_BRICK_ITEM = '<%= user.brick_item || 'basic' %>';
        const USER_BRICK_BALL_DAMAGE = <%= user.brick_ball_damage || 1 %>;
        const USER_BRICK_RESPAWNS = <%= user.brick_respawns || 10 %>;
        
        // Track attempts for this game
        fetch('/api/increment-attempts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ game: 'brick' })
        });
    </script>
</body>
</html>
