<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>MC World - Tor-AI</title>
    <style>
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden;
            background: #000; font-family: 'Malgun Gothic', sans-serif;
            touch-action: none; -webkit-user-select: none; user-select: none;
        }
        #game-wrapper {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            overflow: hidden; touch-action: none;
        }
        #game-container {
            width: 100%; height: 100%; display: block;
        }
        #ui-layer {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 10;
        }
        #mission-box {
            position: absolute; top: env(safe-area-inset-top, 20px); left: env(safe-area-inset-left, 20px);
            background: rgba(0,0,0,0.6); color: white; padding: 12px;
            border-radius: 12px; backdrop-filter: blur(5px); pointer-events: none;
        }
        
        /* 인벤토리: 하단 조작부 위쪽에 배치 (상향 이동 및 2줄 배치) */
        #hotbar {
            position: absolute; bottom: calc(env(safe-area-inset-bottom, 20px) + 130px + 5vh); 
            left: 50%; transform: translateX(-50%);
            display: grid; grid-template-columns: repeat(5, 45px); gap: 8px;
            background: rgba(0,0,0,0.7); padding: 10px;
            border-radius: 12px; pointer-events: auto;
            z-index: 20;
        }
        .hotbar-item {
            width: 45px; height: 45px; border: 2px solid rgba(255,255,255,0.2);
            background-size: 70%; background-repeat: no-repeat; background-position: center;
            border-radius: 8px; background-color: rgba(255,255,255,0.1); position: relative;
        }
        .hotbar-item.active {
            border-color: #2ecc71; background-color: rgba(46, 204, 113, 0.3);
            box-shadow: 0 0 10px rgba(46, 204, 113, 0.5);
        }
        .hotbar-item span {
            position: absolute; top: 1px; right: 3px; font-size: 9px; color: white;
        }

        #minimap-container {
            position: absolute; top: calc(env(safe-area-inset-top, 20px) + 40px); right: env(safe-area-inset-right, 20px);
            width: 110px; height: 110px; border: 2px solid rgba(255,255,255,0.4);
            border-radius: 12px; overflow: hidden; background: rgba(0,0,0,0.5);
            pointer-events: none; z-index: 20;
        }

        #game-menu-btns {
            position: absolute; top: env(safe-area-inset-top, 20px); right: env(safe-area-inset-right, 20px);
            display: flex; gap: 8px; z-index: 30; pointer-events: auto;
        }
        .menu-btn {
            background: rgba(0,0,0,0.6); color: white; padding: 6px 12px; border-radius: 6px;
            font-size: 12px; cursor: pointer; border: 1px solid rgba(255,255,255,0.3);
            font-weight: bold; backdrop-filter: blur(5px);
        }
        #save-btn { background: rgba(46, 204, 113, 0.7); }
        #exit-btn { background: rgba(231, 76, 60, 0.7); }
        #reset-data-btn {
            position: absolute; top: env(safe-area-inset-top, 20px); right: env(safe-area-inset-right, 20px);
            background: rgba(231, 76, 60, 0.8); color: white; padding: 8px 15px;
            border-radius: 8px; font-size: 12px; cursor: pointer; pointer-events: auto;
            border: 1px solid rgba(255,255,255,0.2); font-weight: bold;
        }

        #mobile-controls {
            position: absolute; bottom: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; display: none; z-index: 15;
        }
        @media (max-width: 900px) { #mobile-controls { display: block; } }
        
        #joystick-area {
            position: absolute; bottom: calc(env(safe-area-inset-bottom, 20px) + 20px); 
            left: env(safe-area-inset-left, 30px); width: 100px; height: 100px;
            background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.2);
            border-radius: 50%; pointer-events: auto;
        }
        #joystick-knob {
            position: absolute; top: 30px; left: 30px; width: 40px; height: 40px;
            background: rgba(255,255,255,0.5); border-radius: 50%;
        }
        #action-buttons {
            position: absolute; bottom: calc(env(safe-area-inset-bottom, 20px) + 20px); 
            right: env(safe-area-inset-right, 30px); display: flex; flex-direction: column; gap: 18px;
            align-items: flex-end; pointer-events: none;
        }
        .action-row { display: flex; gap: 18px; pointer-events: none; }
        .action-btn {
            width: 90px; height: 90px; background: rgba(255,255,255,0.2);
            border: 2px solid rgba(255,255,255,0.3); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: white; font-weight: bold; pointer-events: auto; user-select: none; font-size: 18px;
        }
        #mode-btn {
            width: 120px; height: 68px; border-radius: 15px; background: #e74c3c;
            font-size: 16px;
        }
        #mode-btn.build-mode { background: #2ecc71; }
        
        #crosshair {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 16px; height: 16px; pointer-events: none;
        }
        #crosshair::before, #crosshair::after {
            content: ''; position: absolute; background: white; opacity: 0.8;
        }
        #crosshair::before { top: 50%; left: 0; width: 100%; height: 2px; transform: translateY(-50%); }
        #crosshair::after { left: 50%; top: 0; width: 2px; height: 100%; transform: translateX(-50%); }
        
        #intro-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85); color: white; display: flex; flex-direction: column;
            align-items: center; justify-content: center; z-index: 100; text-align: center;
        }
        #error-log {
            position: fixed; bottom: 10px; left: 10px; color: red; font-size: 10px;
            background: rgba(0,0,0,0.8); z-index: 1000; pointer-events: none;
            max-width: 90%; word-break: break-all;
        }
    </style>
    <script>
        window.onerror = function(msg, url, lineNo, columnNo, error) {
            var log = document.getElementById('error-log');
            if (log) {
                var lines = log.innerHTML.split('<br>');
                if (lines.length > 3) lines.shift();
                lines.push(msg + ' (' + lineNo + ':' + columnNo + ')');
                log.innerHTML = lines.join('<br>');
            }
            return false;
        };
    </script>
</head>
<body>
    <div id="error-log"></div>
    <div id="game-wrapper">
        <div id="game-container"></div>
        
        <div id="ui-layer">
            <div id="damage-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; background: rgba(255,0,0,0); transition: background 0.2s; z-index: 5;"></div>
            
            <div id="game-menu-btns">
                <div id="save-btn" class="menu-btn">SAVE</div>
                <div id="exit-btn" class="menu-btn">EXIT</div>
            </div>

            <div id="minimap-container"></div>
            
            <div id="mission-box">
                <p style="margin:0; font-weight: bold; font-size: 12px;">STATUS & MISSION</p>
                <p id="village-name" style="margin: 3px 0; color: #3498db; font-weight: bold; font-size: 15px;">Unknown Wilderness</p>
                <p id="mission-text" style="font-size: 11px; margin: 3px 0; color: #bdc3c7;">[Tip] 몬스터를 잡아 레벨을 올리고 나뭇가지를 모으세요!</p>
                <p style="margin: 3px 0 0 0; color: #f1c40f; font-size: 14px; font-weight: bold;">Lv. <span id="player-level">1</span></p>
                <div style="width: 100%; height: 10px; background: #555; border-radius: 5px; margin: 5px 0;">
                    <div id="hp-bar" style="width: 100%; height: 100%; background: #e74c3c; border-radius: 5px; transition: width 0.2s;"></div>
                </div>
                <div style="width: 100%; height: 8px; background: #333; border-radius: 4px; margin: 3px 0;">
                    <div id="mp-bar" style="width: 100%; height: 100%; background: #3498db; border-radius: 4px; transition: width 0.2s;"></div>
                </div>
                <div style="width: 100%; height: 6px; background: #222; border-radius: 3px; margin: 3px 0;">
                    <div id="exp-bar" style="width: 0%; height: 100%; background: #f1c40f; border-radius: 3px; transition: width 0.3s;"></div>
                </div>
                <p style="margin: 3px 0 0 0; color: #2ecc71; font-size: 12px;">SCORE: <span id="score-val">0</span></p>
                <div id="inventory-btn" style="margin-top: 8px; padding: 5px; background: #3498db; text-align: center; border-radius: 5px; cursor: pointer; pointer-events: auto; font-size: 12px;">INVENTORY (UPGRADE)</div>
            </div>

            <div id="inventory-overlay" style="display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 320px; background: rgba(0,0,0,0.95); border: 2px solid #3498db; border-radius: 12px; padding: 20px; color: white; pointer-events: auto; z-index: 50; box-shadow: 0 0 20px rgba(52, 152, 219, 0.5);">
                <h2 style="margin-top: 0; text-align: center; color: #3498db;">EQUIPMENT UPGRADE</h2>
                <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 15px; border-bottom: 1px solid #444; padding-bottom: 10px;">
                    <div style="font-size: 12px;">Sticks: <span id="inv-sticks" style="color: #f1c40f;">0</span></div>
                    <div style="font-size: 12px;">Wood: <span id="inv-wood" style="color: #e67e22;">0</span></div>
                    <div style="font-size: 12px;">Fruit: <span id="inv-fruit" style="color: #e74c3c;">0</span></div>
                    <div style="font-size: 12px;">Herbs: <span id="inv-herbs" style="color: #2ecc71;">0</span></div>
                    <div style="font-size: 12px;">My Lv: <span id="inv-level" style="color: #2ecc71;">1</span></div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="inv-item" id="inv-sword" style="border: 1px solid #555; padding: 12px; border-radius: 8px; cursor: pointer; background: rgba(255,255,255,0.05);">
                        <div style="font-weight: bold;">Sword Tier: <span id="sword-level">0 (Locked)</span></div>
                        <div id="sword-req" style="font-size: 11px; color: #aaa; margin-top: 4px;">Unlock: Lv.3 + 10 Sticks</div>
                    </div>
                    <div class="inv-item" id="inv-bow" style="border: 1px solid #555; padding: 12px; border-radius: 8px; cursor: pointer; background: rgba(255,255,255,0.05);">
                        <div style="font-weight: bold;">Bow Tier: <span id="bow-level">0 (Locked)</span></div>
                        <div id="bow-req" style="font-size: 11px; color: #aaa; margin-top: 4px;">Unlock: Lv.5 + 20 Sticks</div>
                    </div>
                    <p style="font-size: 10px; color: #e74c3c; margin: 0;">* 업그레이드 시 공격력과 효과가 강화됩니다.</p>
                </div>
                <button id="close-inv-btn" style="width: 100%; margin-top: 15px; padding: 10px; background: #555; border: none; color: white; border-radius: 5px; cursor: pointer;">RETURN TO GAME</button>
            </div>

            <div id="crosshair"></div>

            <div id="hotbar">
                <div class="hotbar-item active" data-block="10" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/items/stick.png');"><span>1</span><label style="position:absolute; bottom:-12px; left:0; width:100%; font-size:7px; text-align:center; color:#f1c40f;">STICK</label></div>
                <div class="hotbar-item" data-block="1" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/blocks/grass_block_side.png');"><span>2</span></div>
                <div class="hotbar-item" data-block="2" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/blocks/dirt.png');"><span>3</span></div>
                <div class="hotbar-item" data-block="3" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/blocks/stone.png');"><span>4</span></div>
                <div class="hotbar-item" data-block="4" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/blocks/oak_log.png');"><span>5</span></div>
                <div class="hotbar-item" data-block="5" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/blocks/oak_leaves.png');"><span>6</span></div>
                <div class="hotbar-item" data-block="6" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/blocks/poppy.png');"><span>7</span></div>
                <div class="hotbar-item" data-block="7" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/blocks/cactus_side.png');"><span>8</span></div>
                <div class="hotbar-item" data-block="9" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/items/bow_pulling_2.png');"><span>9</span><label style="position:absolute; bottom:-12px; left:0; width:100%; font-size:7px; text-align:center;">BOW</label></div>
                <div class="hotbar-item" data-block="11" style="background-image: url('https://raw.githubusercontent.com/PrismarineJS/minecraft-assets/master/data/1.16.4/items/iron_sword.png');"><span>0</span><label style="position:absolute; bottom:-12px; left:0; width:100%; font-size:7px; text-align:center;">SWORD</label></div>
            </div>

            <div id="mobile-controls">
                <div id="joystick-area"><div id="joystick-knob"></div></div>
                <div id="action-buttons">
                    <div id="mode-btn" class="action-btn">REMOVE</div>
                    <div class="action-row">
                        <div id="attack-btn" class="action-btn" style="background: rgba(231, 76, 60, 0.4);">HIT</div>
                        <div id="jump-btn" class="action-btn">JUMP</div>
                    </div>
                </div>
            </div>
        </div>

        <div id="intro-overlay">
            <div id="reset-data-btn">RESET DATA</div>
            <h1 style="font-size: 32px; margin-bottom: 10px;">MC WORLD 2.0</h1>
            <p style="font-size: 16px; opacity: 0.8;">터치하여 시작</p>
        </div>
    </div>

    <script async src="https://unpkg.com/es-module-shims@1.8.0/dist/es-module-shims.js"></script>
    <script type="importmap">
    {
        "imports": {
            "three": "https://unpkg.com/three@0.156.1/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.156.1/examples/jsm/"
        }
    }
    </script>
    <script type="module" src="/js/mc-world/main.js?v=<%= Date.now() %>"></script>
</body>
</html>
