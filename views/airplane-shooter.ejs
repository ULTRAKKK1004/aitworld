<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Tactical Airplane Shooter 1987 - Tor-AI</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/airplane.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { 
            overflow: hidden; 
            background: #000; 
            margin: 0; 
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
            touch-action: none; 
            user-select: none;
            -webkit-user-select: none;
        }

        /* Force Portrait Warning on Mobile */
        #rotate-warning {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100dvh;
            background: #000;
            color: #0f0; 
            z-index: 100000;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        #rotate-warning i { font-size: 5rem; margin-bottom: 20px; animation: tilt-to-portrait 2s infinite; }
        @keyframes tilt-to-portrait { 0%, 100% { transform: rotate(90deg); } 50% { transform: rotate(0deg); } }

        /* 가로 모드일 때만 경고창 표시 */
        @media screen and (orientation: landscape) {
            #rotate-warning { display: flex !important; }
            #game-container { display: none !important; }
        }
        
        #game-container {
            position: relative;
            width: 100vw;
            height: 90vh;
            display: flex;
            flex-direction: column;
            margin-top: 0;
            background: #000;
            overflow: hidden;
            box-shadow: 0 5px 30px rgba(0, 255, 0, 0.1);
        }

        #game-area {
            flex: 1;
            position: relative;
            overflow: hidden;
            min-height: 0;
        }

        #gameCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            image-rendering: pixelated;
            z-index: 1;
        }

        .hud {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            color: #0f0;
            font-size: 18px;
            text-shadow: 2px 2px #000;
            pointer-events: none;
            z-index: 10;
        }

        .stats-panel {
            background: rgba(0, 20, 0, 0.7);
            padding: 10px;
            border: 1px solid #0f0;
            border-radius: 5px;
        }

        .hp-bar-container {
            width: 200px;
            height: 20px;
            border: 2px solid #0f0;
            margin-top: 5px;
            position: relative;
        }

        .hp-bar-fill {
            height: 100%;
            background: #0f0;
            width: 100%;
            transition: width 0.2s;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
            color: #0f0;
            text-align: center;
        }

        .overlay h1 { font-size: 48px; margin-bottom: 20px; }
        .overlay p { font-size: 20px; margin-bottom: 30px; }
        
        .rank-info {
            background: rgba(0, 20, 0, 0.8);
            border: 1px solid #0f0;
            border-radius: 8px;
            padding: 15px 25px;
            margin: 15px 0;
            text-align: center;
            min-width: 300px;
        }
        
        .rank-info .rank-title {
            color: #ff0;
            font-size: 16px;
            margin-bottom: 10px;
            text-shadow: 0 0 10px #ff0;
        }
        
        .rank-info .my-rank {
            color: #0ff;
            font-size: 28px;
            font-weight: bold;
            margin: 10px 0;
        }
        
        .rank-info .top-score {
            color: #f0f;
            font-size: 18px;
        }
        
        .rank-info .rivals-list {
            margin-top: 10px;
            font-size: 14px;
            color: #aaa;
        }
        
        .rank-info .rival-item {
            padding: 3px 0;
        }
        
        .rank-info .rank-section {
            padding: 10px 0;
            border-bottom: 1px solid rgba(0, 255, 0, 0.3);
        }
        
        .rank-info .rank-section:last-child {
            border-bottom: none;
        }
        
        .rank-info .rival-item.current {
            color: #0ff;
            font-weight: bold;
        }
        
        .start-btn {
            padding: 15px 40px;
            font-size: 24px;
            background: #0f0;
            color: #000;
            border: none;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 0 15px #0f0;
        }

        .start-btn:hover {
            background: #fff;
            box-shadow: 0 0 25px #fff;
        }

        /* CRT Effect */
        .crt::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 2;
            background-size: 100% 2px, 3px 100%;
            pointer-events: none;
        }

        .crt::after {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: rgba(18, 16, 16, 0.1);
            opacity: 0;
            z-index: 2;
            pointer-events: none;
            animation: flicker 0.15s infinite;
        }

        @keyframes flicker {
            0% { opacity: 0.27861; }
            5% { opacity: 0.34769; }
            10% { opacity: 0.23604; }
            15% { opacity: 0.90626; }
            20% { opacity: 0.18128; }
            25% { opacity: 0.83891; }
            30% { opacity: 0.65583; }
            35% { opacity: 0.57807; }
            40% { opacity: 0.26559; }
            45% { opacity: 0.84693; }
            50% { opacity: 0.96019; }
            55% { opacity: 0.08523; }
            60% { opacity: 0.71056; }
            65% { opacity: 0.73437; }
            70% { opacity: 0.28574; }
            75% { opacity: 0.96387; }
            80% { opacity: 0.11453; }
            85% { opacity: 0.39905; }
            90% { opacity: 0.61335; }
            95% { opacity: 0.61053; }
            100% { opacity: 0.52208; }
        }

        .back-link {
            position: absolute;
            bottom: 230px;
            left: 20px;
            color: #0f0;
            text-decoration: none;
            border: 1px solid #0f0;
            padding: 5px 10px;
            z-index: 20;
        }

        .back-link:hover { background: rgba(0, 255, 0, 0.2); }
        
        /* Mobile Controls */
        #mobile-controls {
            height: 180px;
            width: 100%;
            display: none;
            justify-content: space-between;
            padding: 10px 40px;
            box-sizing: border-box;
            z-index: 50;
            pointer-events: none;
            flex-shrink: 0;
            position: relative;
        }

        #game-area canvas {
            width: 100%;
            height: 100%;
        }

        .touch-zone {
            pointer-events: auto;
            user-select: none;
            -webkit-user-select: none;
        }

        .joystick-base {
            width: 150px;
            height: 150px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(0, 255, 0, 0.3);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .joystick-stick {
            width: 60px;
            height: 60px;
            background: rgba(0, 255, 0, 0.4);
            border-radius: 50%;
            box-shadow: 0 0 15px rgba(0, 255, 0, 0.5);
        }

        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: flex-end;
        }

        .btn-round {
            width: 80px;
            height: 80px;
            background: rgba(0, 255, 0, 0.2);
            border: 3px solid #0f0;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            color: #0f0;
            font-size: 24px;
            box-shadow: 0 0 10px rgba(0, 255, 0, 0.3);
        }

        .btn-round:active {
            background: rgba(0, 255, 0, 0.6);
            transform: scale(0.9);
        }

        .btn-magic {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 0, 0.2);
            border-color: #ff0;
            color: #ff0;
            font-size: 18px;
            opacity: 0.4;
            pointer-events: none;
        }

        .btn-magic.active {
            opacity: 1;
            pointer-events: auto;
            animation: magic-pulse 1s infinite;
        }

        .btn-round.btn-item {
            width: 80px;
            height: 80px;
            font-size: 24px;
            border-color: #f1c40f;
            color: #f1c40f;
            background: rgba(241, 196, 15, 0.2);
            box-shadow: 0 0 15px rgba(241, 196, 15, 0.4);
            display: none; /* Only show if item exists */
        }
        .btn-round.btn-item:active { background: rgba(241, 196, 15, 0.6); }

        #item-controls {
            position: absolute;
            bottom: 30px;
            left: 55%;
            transform: translateX(-50%);
            display: flex;
            gap: 20px;
            z-index: 60;
            pointer-events: none;
        }

        @keyframes magic-pulse {
            0% { box-shadow: 0 0 10px rgba(255, 255, 0, 0.5); }
            50% { box-shadow: 0 0 25px rgba(255, 255, 0, 0.9); }
            100% { box-shadow: 0 0 10px rgba(255, 255, 0, 0.5); }
        }

        @media (max-width: 1024px) {
            #mobile-controls { display: flex; }
        }
    </style>
</head>
<body class="crt">
    <!-- Orientation Warning Overlay -->
    <div id="rotate-warning">
        <i class="fas fa-mobile-screen"></i>
        <p>세로 모드로 전환해주세요!</p>
        <p style="font-size: 14px; color: #888; margin-top: 10px;">이 게임은 세로 화면에 최적화되어 있습니다.</p>
    </div>

    <div id="game-container">
        <div class="hud">
            <div class="stats-panel">
                <div>SCORE: <span id="score">000000</span></div>
                <div>STAGE: <span id="stage">1/100</span></div>
                <div>LIVES: <span id="lives">3</span></div>
                <div class="hp-bar-container">
                    <div id="hp-fill" class="hp-bar-fill"></div>
                    <div style="position:absolute; top:0; width:100%; text-align:center; font-size:12px; color:#000; font-weight:bold;">HP</div>
                </div>
            </div>
            <div class="stats-panel">
                <div>WEAPON: <span id="weapon-type">NORMAL</span></div>
                <div>SHIELD: <span id="shield-status">OFF</span></div>
                <div id="magic-indicator" style="color: #ff0; display: none;">x0</div>
            </div>
            
            <div id="shop-items-panel" class="stats-panel" style="border-color: #f1c40f; color: #f1c40f; font-size: 14px; min-width: 120px;">
                <div style="font-weight: bold; margin-bottom: 5px; border-bottom: 1px solid #f1c40f;">SHOP ITEMS</div>
                <div id="airplane-potions" style="cursor: pointer;" onclick="useShopItem('airplane_hp_potion')">HP Potion: <span id="potion-count">0</span> (Key: 1)</div>
                <div id="airplane-shields" style="cursor: pointer;" onclick="useShopItem('airplane_shield')">Shield: <span id="shield-count">0</span> (Key: 2)</div>
            </div>
        </div>

        <div id="game-area">
            <canvas id="gameCanvas"></canvas>
        </div>

        <!-- Mobile Overlays -->
        <div id="mobile-controls">
            <div id="joystick-zone" class="touch-zone">
                <div class="joystick-base">
                    <div id="joystick-stick" class="joystick-stick"></div>
                </div>
            </div>
            
            <div id="item-controls">
                <div id="btn-item-potion-touch" class="touch-zone btn-round btn-item" onclick="useShopItem('airplane_hp_potion')">P</div>
                <div id="btn-item-shield-touch" class="touch-zone btn-round btn-item" onclick="useShopItem('airplane_shield')">S</div>
            </div>

            <div class="action-buttons">
                <div id="btn-magic-touch" class="touch-zone btn-round btn-magic">M</div>
                <div id="btn-shoot-touch" class="touch-zone btn-round">FIRE</div>
            </div>
        </div>

        <div id="start-screen" class="overlay">
            <h1>TACTICAL AIRPLANE 1987</h1>
            <p>상하좌우(WASD/Arrow) 이동 | 발사(Space/Click) | 특수마법(X/R-Click)</p>
            <button class="start-btn" onclick="startGame()">MISSION START</button>
            <p style="margin-top: 20px; font-size: 14px; color: #888;">PLAYER: <%= user.username %> | ATTEMPTS: <%= user.airplane_attempts %></p>
        </div>

        <div id="game-over-screen" class="overlay" style="display: none;">
            <h1 id="result-title">MISSION FAILED</h1>
            <p>FINAL SCORE: <span id="final-score">0</span></p>
            <div class="rank-info" id="end-rank-info">
                <div style="color: #888;">순위 정보를 확인하는 중...</div>
            </div>
            <p id="result-msg"></p>
            <button class="start-btn" onclick="location.reload()">RETRY MISSION</button>
            <button class="start-btn" onclick="exitToDashboard()" style="background: transparent; border: 1px solid #0f0; color: #0f0; margin-top: 10px; font-size: 18px;">BACK TO DASHBOARD</button>
        </div>

        <a href="javascript:void(0)" onclick="exitToDashboard()" class="back-link">EXIT TO DASHBOARD</a>
    </div>

    <script>
        const currentUser = {
            username: "<%= user.username %>",
            attempts: <%= user.airplane_attempts %>,
            airplaneLevel: <%= user.airplane_level || 1 %>,
            airplaneScoreMultiplier: <%= user.airplane_score_multiplier || 1.0 %>,
            airplaneItem: '<%= user.airplane_item || 'basic' %>',
            airplaneMissileMultiplier: <%= user.airplane_missile_multiplier || 1.0 %>
        };

        let shopItems = {
            airplane_hp_potion: 0,
            airplane_shield: 0
        };

        async function loadShopItems() {
            try {
                const res = await fetch('/api/airplane-shooter/load');
                const data = await res.json();
                if (data.success && data.items) {
                    data.items.forEach(item => {
                        if (shopItems.hasOwnProperty(item.item_key)) {
                            shopItems[item.item_key] = item.quantity;
                        }
                    });
                    updateShopUI();
                }
            } catch (e) {
                console.error("Failed to load shop items", e);
            }
        }

        function updateShopUI() {
            document.getElementById('potion-count').innerText = shopItems.airplane_hp_potion;
            document.getElementById('shield-count').innerText = shopItems.airplane_shield;
            
            // Toggle mobile buttons
            const potionBtn = document.getElementById('btn-item-potion-touch');
            const shieldBtn = document.getElementById('btn-item-shield-touch');
            if (potionBtn) potionBtn.style.display = shopItems.airplane_hp_potion > 0 ? 'flex' : 'none';
            if (shieldBtn) shieldBtn.style.display = shopItems.airplane_shield > 0 ? 'flex' : 'none';
        }

        async function useShopItem(itemKey) {
            if (shopItems[itemKey] <= 0) return;

            try {
                const res = await fetch('/api/shop/consume', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ itemKey })
                });
                const data = await res.json();
                if (data.success) {
                    shopItems[itemKey]--;
                    updateShopUI();
                    applyItemEffect(itemKey);
                }
            } catch (e) {
                console.error("Failed to consume item", e);
            }
        }

        function applyItemEffect(itemKey) {
            // Airplane logic uses global variables for HP and Shield
            if (itemKey === 'airplane_hp_potion') {
                const maxHP = planeLevel * 100;
                hp = Math.min(hp + 50, maxHP);
                if (typeof updateHUD === 'function') updateHUD();
                customNotify("HP Potion Used! +50 HP");
            } else if (itemKey === 'airplane_shield') {
                shieldLayers = (shieldLayers || 0) + 1;
                if (typeof updateHUD === 'function') updateHUD();
                customNotify("Shield Battery Used! +1 Layer");
            }
        }

        function customNotify(msg) {
            const notif = document.createElement('div');
            notif.innerText = msg;
            notif.style.position = 'fixed';
            notif.style.bottom = '250px';
            notif.style.left = '50%';
            notif.style.transform = 'translateX(-50%)';
            notif.style.background = 'rgba(241, 196, 15, 0.9)';
            notif.style.color = '#000';
            notif.style.padding = '10px 20px';
            notif.style.borderRadius = '20px';
            notif.style.fontWeight = 'bold';
            notif.style.zIndex = '1000';
            notif.style.boxShadow = '0 0 15px rgba(241, 196, 15, 0.5)';
            document.body.appendChild(notif);
            setTimeout(() => notif.remove(), 2000);
        }

        window.addEventListener('keydown', (e) => {
            if (e.key === '1') useShopItem('airplane_hp_potion');
            if (e.key === '2') useShopItem('airplane_shield');
        });

        loadShopItems();
    </script>
    <script src="/js/airplane-logic.js"></script>
</body>
</html>
