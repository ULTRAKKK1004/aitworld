<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Tor-AI</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="user-info">
                <span>반갑습니다, <strong><%= user.username %></strong> 님!</span>
                <a href="/logout" class="logout-link">로그아웃</a>
            </div>
            <h1>TOR-AI SERVICES</h1>
        </header>
        <main>
            <div class="service-grid">
                <% if (user.role === 'ADMIN') { %>
                <a href="/admin" class="service-card" style="border-color: #f1c40f;">
                    <div class="icon-box" style="color: #f1c40f; text-shadow: 0 0 20px #f1c40f;">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h2>ADMIN MODE</h2>
                    <p>관리자 대시보드</p>
                </a>
                <% } %>
                <a href="/games/brick-crasher" class="service-card">
                    <div class="icon-box">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <h2>BRICK CRASHER</h2>
                    <p>NEON BREAKOUT</p>
                </a>
                <a href="/games/airplane-shooter" class="service-card" style="border-color: var(--secondary);">
                    <div class="icon-box" style="color: var(--secondary); text-shadow: 0 0 20px var(--secondary);">
                        <i class="fas fa-plane"></i>
                    </div>
                    <h2>AIRPLANE SHOOTER</h2>
                    <p>TACTICAL 1987 SHMUP</p>
                </a>
                <a href="/games/hero-quest" class="service-card" style="border-color: #3498db;">
                    <div class="icon-box" style="color: #3498db; text-shadow: 0 0 20px #3498db;">
                        <i class="fas fa-dragon"></i>
                    </div>
                    <h2>HERO QUEST</h2>
                    <p>LEGENDARY ADVENTURE</p>
                </a>
                <a href="/games/mc-world" class="service-card" style="border-color: #2ecc71;">
                    <div class="icon-box" style="color: #2ecc71; text-shadow: 0 0 20px #2ecc71;">
                        <i class="fas fa-cubes"></i>
                    </div>
                    <h2>MC WORLD</h2>
                    <p>VOXEL DECORATION WORLD</p>
                </a>
                <a href="/games/lift-rush" class="service-card" style="border-color: #ff00ff;">
                    <div class="icon-box" style="color: #ff00ff; text-shadow: 0 0 20px #ff00ff;">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <h2>LIFT RUSH</h2>
                    <p>NEON VERTICAL ARCADE</p>
                </a>
                <!-- Future services can be added here -->
            </div>
        </main>
    </div>
</body>
</html>
